# Exemplo sem credenciais. Copie para .env.local e preencha apenas localmente.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
# Segredo Supabase: exclusivamente no servidor, nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace_with_server_only_secret_key
# Compatibilidade legada; prefira SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=replace_with_legacy_server_only_key_if_still_needed
CASA_DOS_DADOS_API_KEY=replace_with_api_key
CRM_SELF_REGISTRATION_ENABLED=false
PROSPECTING_CRON_SECRET=replace_with_random_cron_secret
CLICKSIGN_ENVIRONMENT=sandbox
CLICKSIGN_ACCESS_TOKEN=replace_with_clicksign_token
GMAIL_CLIENT_ID=replace_with_google_oauth_client_id
GMAIL_CLIENT_SECRET=replace_with_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_random_key
